  "staticFiles": {
    "staticPath": "public"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@microsoft/signalr": "10.0.11",
    "@mui/material": "^9.4.0",
    "@react-google-maps/api": "2.20.8",
    "assets": "3.0.1",
    "index": "0.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
